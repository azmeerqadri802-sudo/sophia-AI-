{
  "name": "omnix-sophia-crm",
  "version": "2.0.0",
  "description": "Sophia v2.0 - Autonomous AI Lead Gen CRM Desktop Software by Omnix Global",
  "main": "electron-main.js",
  "author": "Omnix Global",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.omnixglobal.sophiacrm",
    "productName": "Sophia-AI-CRM",
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Sophia-AI-CRM.exe"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "backend/**/*",
      "database/**/*",
      "frontend/out/**/*",
      "package.json"
    ]
  }
}